# Local environment for the modular monolith. Copy it and edit the copy:
#
#   cp .env.example .env
#
# `.env` is git-ignored; this file is not, and everything in it is a local-only
# placeholder. There is no secret here and nothing here grants access to any
# system but your own machine. If a value ever needs to be a real credential, it
# belongs in your untracked `.env`, not in this file.
#
# `docker compose` reads `.env` automatically. The Makefile reads the same file
# so a recipe can use these values too, and falls back to the identical defaults
# written out in the Makefile when `.env` does not exist — a clean checkout runs
# with no `.env` at all.

# Compose project name. Prefixes the container and the named volume, so two
# checkouts of this repository on one machine do not fight over the same port or
# the same data. Change it if you run a second copy locally.
COMPOSE_PROJECT_NAME=been-there

# Postgres superuser for the local container. Local-only; nothing else uses it.
POSTGRES_USER=been_there

# Postgres password for POSTGRES_USER. Local-only placeholder: the port is bound
# to localhost, the volume is a throwaway, and this string is published in this
# repository on purpose so nobody has to invent one.
POSTGRES_PASSWORD=been_there_local_only

# Database the local container creates on first start. Holds every domain's
# tables once a schema exists (ADR 0001: one transactional store).
POSTGRES_DB=been_there

# Host port published for Postgres. Deliberately not 5432 so an install of
# Postgres on the host keeps working alongside this.
POSTGRES_PORT=55432

# What an application process would connect with. Derived from the five values
# above; override it only if you move the database off the local container.
DATABASE_URL=postgres://been_there:been_there_local_only@localhost:55432/been_there

# Secret the Trust & Safety layer keys its report/unmatch pairing token with.
#
# Local-only placeholder, published here for the same reason the Postgres
# password is: a clean checkout should run `make demo` without inventing one.
# It is a keyed HMAC over (report id, match id, reported account) that lets a
# detector prove an unmatch and a report describe the same pair without either
# learning who reported whom. There is no production value here and nothing to
# protect on your own machine — but the pairing is only as good as this string,
# so a real deployment sets its own and never reuses this one. Rotating it
# retires every token already published.
#
# What it changes: with a secret set, the catalogue runs six detectors rather
# than five, adding `interaction.unmatch_report` — the only one loud enough to
# carry a subject to `high`. Without one, that detector is deliberately not
# constructible, because a detector that cannot verify a token must not be
# silently present and never fire.
#
# It does NOT make `safety.detected_before_first_report` move. That metric
# compares a detection against the *first report* naming the subject, and this
# detector only fires after one exists, so it can raise the state but can never
# be the first thing to have raised it. The metrics endpoint computes and serves
# that fact as `detection` rather than leaving a permanent zero to be read as
# detection working.
RISK_PAIRING_SECRET=been_there_local_pairing_only
