{
  "name": "been-there",
  "private": true,
  "version": "0.1.0",
  "description": "Been There — verified, safe dating core. Architecture and domain contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty",
    "typecheck-tests": "node scripts/dev/typecheck-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node scripts/check-doc-links.mjs",
    "research": "node scripts/research/search.mjs",
    "check": "npm run typecheck && npm run typecheck-tests && npm test && npm run docs",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "demo:bundle": "node scripts/demo/bundle.mjs",
    "demo:serve": "node scripts/demo/server.mjs",
    "demo:journey": "npm run --silent build && node scripts/demo/journey.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
